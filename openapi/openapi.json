    "paths": {
        "/cocktails/{cocktail}": {
            "get": {
                "operationId": "cocktailDetail",
                "description": "\u4e0b\u66f8\u304d\u30fb\u7121\u3044\u30ab\u30af\u30c6\u30eb\u306f 404(\u65e7\u306f\u4e0b\u66f8\u304d\u3082\u8fd4\u3057\u3001\u7121\u3044 ID \u306f 500 \u3060\u3063\u305f\u3002docs/decisions/cocktail-detail.md)\u3002",
                "summary": "\u30ab\u30af\u30c6\u30eb\u306e\u8a73\u7d30\u3092\u8fd4\u3059\u3002\u57fa\u672c\u60c5\u5831\u30fb\u6280\u6cd5(\u3068\u3001\u305d\u308c\u3092\u8aac\u660e\u3059\u308b\u7528\u8a9e\u306e ID)\u30fb\u30b0\u30e9\u30b9\u30fb\u6c37\u3068\u3001\u6750\u6599\u3092\u4e26\u3073\u9806(position)\u3067\u8fd4\u3059\u3002\n\u6750\u6599\u3054\u3068\u306b\u3001\u30ce\u30fc\u30c9\u306e\u6839\u304b\u3089\u306e\u30d1\u30f3\u304f\u305a\u3068\u9298\u67c4\u3092\u8fd4\u3059\u3002",
                "tags": [
                    "CocktailDetail"
                ],
                "parameters": [
                    {
                        "name": "cocktail",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`CocktailDetailResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/CocktailDetailResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/admin/cocktails/{cocktail}/preview": {
            "get": {
                "operationId": "admin.cocktailPreview",
                "description": "\u516c\u958b\u306e API \u306f\u30bb\u30c3\u30b7\u30e7\u30f3\u3092\u4f7f\u308f\u306a\u3044\u306e\u3067\u3001\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u304b\u3067\u8fd4\u3059\u3082\u306e\u3092\u5909\u3048\u3089\u308c\u306a\u3044\u3002\u7ba1\u7406\u8005\u304c\u4e0b\u66f8\u304d\u3092\n\u516c\u958b\u306e\u8a73\u7d30\u3068\u540c\u3058\u5f62\u3067\u78ba\u304b\u3081\u3089\u308c\u308b\u3088\u3046\u3001\u7ba1\u7406 API \u306b\u7f6e\u304f\u3002",
                "summary": "\u516c\u958b\u306e\u8a73\u7d30(GET /api/cocktails/{id})\u3068\u540c\u3058\u5f62\u3067\u3001\u4e0b\u66f8\u304d\u3082\u542b\u3081\u3066\u30ab\u30af\u30c6\u30eb\u306e\u8a73\u7d30\u3092\u8fd4\u3059\u3002",
                "tags": [
                    "CocktailPreview"
                ],
                "parameters": [
                    {
                        "name": "cocktail",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`CocktailDetailResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/CocktailDetailResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    }
                }
            }
        },
        "/cocktails/{cocktail}/same-name": {
            "get": {
                "operationId": "cocktailSameName",
                "description": "\u300c\u540c\u3058\u540d\u524d\u300d\u306f\u82f1\u540d(name_eng)\u304c\u540c\u3058\u3082\u306e(\u65e7 CocktailFactory::sameName)\u3002\u4e0b\u66f8\u304d\u306f\u8fd4\u3055\u305a\u3001\u4e0b\u66f8\u304d\u30fb\u7121\u3044\u30ab\u30af\u30c6\u30eb\u3092\n\u6307\u5b9a\u3057\u305f\u3089 404\u3002\u82f1\u540d\u306e\u7121\u3044\u30ab\u30af\u30c6\u30eb\u306f\u6bd4\u3079\u308b\u540d\u524d\u304c\u7121\u3044\u306e\u3067 0 \u4ef6(docs/decisions/cocktail-detail.md)\u3002",
                "summary": "\u540c\u3058\u540d\u524d\u306e\u5225\u306e\u30ab\u30af\u30c6\u30eb\u3092\u3001ID \u306e\u9806\u3067\u8fd4\u3059\u3002",
                "tags": [
                    "CocktailSameName"
                ],
                "parameters": [
                    {
                        "name": "cocktail",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Array of `CocktailSummaryResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/CocktailSummaryResource"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
