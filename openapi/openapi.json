{
    "openapi": "3.1.2",
    "info": {
        "title": "cocktail-db",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "http://localhost:8000/api"
        }
    ],
    "paths": {
        "/admin/cocktails": {
            "get": {
                "operationId": "admin.cocktailIndex",
                "description": "\u540d\u524d\u306f\u30ab\u30bf\u30ab\u30ca\u3092\u3072\u3089\u304c\u306a\u306b\u3001\u5168\u89d2\u306e\u82f1\u6570\u5b57\u3092\u534a\u89d2\u306b\u3001\u5927\u6587\u5b57\u3092\u5c0f\u6587\u5b57\u306b\u305d\u308d\u3048\u3066\u6bd4\u3079\u3001\u540c\u3058\u306a\u3089 ID \u306e\u9806(\u65e7\u306e\u7ba1\u7406\u753b\u9762\u306e\n\u4e00\u89a7\u3068\u540c\u3058\u4e26\u3073)\u3002q \u306f\u540d\u524d\u304b\u82f1\u540d\u306e\u3069\u3053\u304b\u306b\u542b\u3080\u3082\u306e\u306b\u7d5e\u308b(\u82f1\u540d\u306f\u5927\u6587\u5b57\u30fb\u5c0f\u6587\u5b57\u3092\u533a\u5225\u3057\u306a\u3044)\u3002",
                "summary": "\u7ba1\u7406\u753b\u9762\u306e\u30ab\u30af\u30c6\u30eb\u306e\u4e00\u89a7\u3002\u516c\u958b\u6e08\u307f\u304b\u4e0b\u66f8\u304d\u306e\u3069\u3061\u3089\u304b\u3092\u3001\u540d\u524d\u306e\u6607\u9806\u3067 1 \u30da\u30fc\u30b8\u305a\u3064\u8fd4\u3059\u3002",
                "tags": [
                    "CocktailIndex"
                ],
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "required": true,
                        "description": "published: \u516c\u958b\u6e08\u307f / draft: \u4e0b\u66f8\u304d",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "published",
                                "draft"
                            ]
                        }
                    },
                    {
                        "name": "q",
                        "in": "query",
                        "description": "\u540d\u524d\u304b\u82f1\u540d\u306e\u3069\u3053\u304b\u306b\u542b\u3080\u8a9e(#284 \u306e 6\u3002\u90e8\u5206\u4e00\u81f4)",
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "maxLength": 255
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": [
                                "integer",
                                "null"
                            ],
                            "minimum": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": [
                                "integer",
                                "null"
                            ],
                            "minimum": 1,
                            "maximum": 50
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated set of `CocktailListItemResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/CocktailListItemResource"
                                            }
                                        },
                                        "links": {
                                            "type": "object",
                                            "properties": {
                                                "first": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "last": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "prev": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "next": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "first",
                                                "last",
                                                "prev",
                                                "next"
                                            ]
                                        },
                                        "meta": {
                                            "type": "object",
                                            "properties": {
                                                "current_page": {
                                                    "type": "integer",
                                                    "minimum": 1
                                                },
                                                "from": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ],
                                                    "minimum": 1
                                                },
                                                "last_page": {
                                                    "type": "integer",
                                                    "minimum": 1
                                                },
                                                "links": {
                                                    "type": "array",
                                                    "description": "Generated paginator links.",
                                                    "items": {
                                                        "type": "object",
                                                        "properties": {
                                                            "url": {
                                                                "type": [
                                                                    "string",
                                                                    "null"
                                                                ]
                                                            },
                                                            "label": {
                                                                "type": "string"
                                                            },
                                                            "active": {
                                                                "type": "boolean"
                                                            }
                                                        },
                                                        "required": [
                                                            "url",
                                                            "label",
                                                            "active"
                                                        ]
                                                    }
                                                },
                                                "path": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ],
                                                    "description": "Base path for paginator generated URLs."
                                                },
                                                "per_page": {
                                                    "type": "integer",
                                                    "description": "Number of items shown per page.",
                                                    "minimum": 0
                                                },
                                                "to": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ],
                                                    "description": "Number of the last item in the slice.",
                                                    "minimum": 1
                                                },
                                                "total": {
                                                    "type": "integer",
                                                    "description": "Total number of items being paginated.",
                                                    "minimum": 0
                                                }
                                            },
                                            "required": [
                                                "current_page",
                                                "from",
                                                "last_page",
                                                "links",
                                                "path",
                                                "per_page",
                                                "to",
                                                "total"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "links",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/admin/me": {
            "get": {
                "operationId": "admin.currentAdmin",
                "summary": "\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u7ba1\u7406\u8005\u3092\u8fd4\u3059\u3002",
                "tags": [
                    "CurrentAdmin"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "name": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "id",
                                        "name"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/hello": {
            "get": {
                "operationId": "hello",
                "summary": "\u758e\u901a\u78ba\u8a8d\u7528\u306e\u30e1\u30c3\u30bb\u30fc\u30b8\u3092\u8fd4\u3059\u3002",
                "tags": [
                    "Hello"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "const": "Hello World from Laravel"
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/search-form": {
            "get": {
                "operationId": "searchForm",
                "description": "\u6728\u306f\u6839\u304b\u3089\u4e00\u756a\u6df1\u3044\u6bb5\u307e\u3067\u5165\u308c\u5b50\u3067\u8fd4\u3059(docs/schema.md \u306e\u300c\u691c\u7d22\u30d5\u30a9\u30fc\u30e0(#95)\u306b\u51fa\u3059\u6df1\u3055\u300d)\u3002\u6839\u3082\u5b50\u3082\u5144\u5f1f\u306e\u4e26\u3073\u9806\u3002\n\u30ab\u30af\u30c6\u30eb\u306b\u4f7f\u308f\u308c\u3066\u3044\u308b\u304b\u3067\u306f\u7d5e\u3089\u305a\u3001\u4e0b\u66f8\u304d\u306e\u30ab\u30af\u30c6\u30eb\u3067\u3057\u304b\u4f7f\u3063\u3066\u3044\u306a\u3044\u30ce\u30fc\u30c9\u3082\u8fd4\u3059(\u65e7\u306e getKindsForForm \u3082\n\u3059\u3079\u3066\u306e\u30ab\u30c6\u30b4\u30ea\u30fb\u30df\u30c9\u30eb\u3092\u8fd4\u3057\u3066\u3044\u305f)\u3002\u6280\u6cd5\u306f ID \u306e\u9806\u3002",
                "summary": "\u691c\u7d22\u30d5\u30a9\u30fc\u30e0\u306b\u51fa\u3059\u30ab\u30c6\u30b4\u30ea\u306e\u6728\u3068\u6280\u6cd5\u306e\u4e00\u89a7\u3092\u8fd4\u3059\u3002",
                "tags": [
                    "SearchForm"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "categories": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/SearchFormNodeResource"
                                            }
                                        },
                                        "methods": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/SearchFormMethodResource"
                                            }
                                        }
                                    },
                                    "required": [
                                        "categories",
                                        "methods"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CategoryRole": {
                "type": "string",
                "description": "\u30ab\u30c6\u30b4\u30ea\u6728\u306e\u6839\u306e\u5f79\u5272(categories.role\u3002docs/decisions/category-root-role.md\u3002#153)\u3002 \u65e7\u306f\u7a2e\u5225\u306e ID(m_category.kind)\u3092\u6570\u5b57\u3067\u6c7a\u3081\u6253\u3061\u3057\u3066\u5224\u5b9a\u3057\u3066\u3044\u305f\u3002\u65b0\u3057\u3044\u6728\u3067\u306f\u7a2e\u5225\u304c\u6839\u306e\u30ce\u30fc\u30c9\u306b\u306a\u308a ID \u3082 \u632f\u308a\u76f4\u3059\u306e\u3067\u3001\u5f79\u5272\u306e\u540d\u524d\u3067\u6301\u3064\u3002\u5f79\u5272\u306e\u7121\u3044\u6839(\u65e7\u306e\u84b8\u7559\u9152\u30fb\u91b8\u9020\u9152\u30fb\u6df7\u6210\u9152)\u306f null \u3067\u3001\u3053\u3053\u306b\u306f\u73fe\u308c\u306a\u3044\u3002\n| |\n|---|\n| `soft_drink` <br/> \u65e7\u306e kind 4 |\n| `other` <br/> \u65e7\u306e kind 5(\u30ac\u30fc\u30cb\u30c3\u30b7\u30e5\u306a\u3069) |",
                "enum": [
                    "soft_drink",
                    "other"
                ],
                "title": "CategoryRole"
            },
            "CocktailListItemResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "name_eng": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "is_draft": {
                        "type": "boolean"
                    },
                    "updated_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "id",
                    "name",
                    "name_eng",
                    "is_draft",
                    "updated_at"
                ],
                "title": "CocktailListItemResource"
            },
            "SearchFormMethodResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "name"
                ],
                "title": "SearchFormMethodResource"
            },
            "SearchFormNodeResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "is_major": {
                        "type": "boolean",
                        "description": "\u65e7\u306e\u753b\u9762\u306e\u300c\u30e1\u30b8\u30e3\u30fc\u3067\u306a\u3044\u9805\u76ee\u306e\u8868\u793a/\u975e\u8868\u793a\u300d\u306b\u4f7f\u3046"
                    },
                    "root_role": {
                        "anyOf": [
                            {
                                "description": "\u30ce\u30fc\u30c9\u306e\u6839\u306e\u5f79\u5272\u3002\u3042\u308b\u3082\u306e\u691c\u7d22\u3067\u300c\u305d\u306e\u4ed6\u300d(other)\u3092\u6301\u3063\u3066\u3044\u306a\u304f\u3066\u3088\u3044\u3053\u3068\u3092\u753b\u9762\u3067\u793a\u3059\u306e\u306b\u4f7f\u3046\n| |\n|---|\n| `soft_drink` <br/> \u65e7\u306e kind 4 |\n| `other` <br/> \u65e7\u306e kind 5(\u30ac\u30fc\u30cb\u30c3\u30b7\u30e5\u306a\u3069) |",
                                "$ref": "#/components/schemas/CategoryRole"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "children": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/SearchFormNodeResource"
                        }
                    }
                },
                "required": [
                    "id",
                    "name",
                    "is_major",
                    "root_role",
                    "children"
                ],
                "title": "SearchFormNodeResource"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            }
        }
    }
}